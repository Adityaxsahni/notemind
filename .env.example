# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=local

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_USER=notemind
POSTGRES_PASSWORD=
POSTGRES_DB=notemind
DATABASE_URL=postgresql+psycopg://notemind:<POSTGRES_PASSWORD>@127.0.0.1:5432/notemind

REDIS_URL=redis://127.0.0.1:6379/0

# Added in Phase 6. The model name picks the vendor: claude-* uses an Anthropic key,
# gemini-* a Google Gemini API key.
LLM_API_KEY=
# LLM_ANSWER_MODEL=claude-opus-5-5
# Handwriting, scans and photos are transcribed by a vision model with the same key.
# OCR_MODEL=                              # default: LLM_ANSWER_MODEL
# OCR_PAGES_PER_REQUEST=4
# OCR_MAX_PAGES=300
# LLM_USER_DAILY_OCR_TOKEN_BUDGET=1000000 # ~500 handwritten pages per user per day

# Capacity (docs/PERFORMANCE.md). Each API process loads the search models (~0.9 GB RAM).
# WEB_CONCURRENCY=1
# API_TORCH_THREADS=2
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10

# Bot protection (optional): Cloudflare Turnstile keys from https://dash.cloudflare.com.
# The site key is public (sent to browsers); the secret key stays on the backend.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# BOT_MIN_FILL_SECONDS=2
# GLOBAL_RATE_LIMIT_PER_MINUTE=600
# CORS is off by default (the browser uses the frontend's origin). List exact origins only if
# another site must call the API, e.g. CORS_ORIGINS=["https://app.example.com"]
# CORS_ORIGINS=[]

# Frontend build settings (public: inlined into the browser bundle, never secrets)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=privacy@notemind.example
# Behind TLS in production: HSTS, upgrade-insecure-requests and an HTTP->HTTPS redirect
FORCE_HTTPS=false
